height="30.799999999999997" as="geometry" /></mxCell><mxCell id="s63" value="&lt;font style=&quot;font-size:19px&quot; color=&quot;#22262E&quot;&gt;• mean measured latency per question (main axis)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:19px&quot; color=&quot;#22262E&quot;&gt;• tokens, output priced 4x, FLOPs, calls&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="834.0" y="453.9" width="542.0" height="53.4" as="geometry" /></mxCell><mxCell id="s64" value="" style="rounded=1;arcSize=9;html=1;fillColor=#DAEFEC;strokeColor=#8FC3BC;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="8" y="522" width="1384" height="150" as="geometry" /></mxCell><mxCell id="s65" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot; color=&quot;#0F5E63&quot;&gt;Plan matrix&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#5B6170&quot;&gt;every question&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#5B6170&quot;&gt;x every plan&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:17px&quot; color=&quot;#5B6170&quot;&gt;x every reader&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="14" y="522" width="214" height="150" as="geometry" /></mxCell><mxCell id="s66" value="" style="rounded=1;arcSize=7;html=1;fillColor=#ffffff;strokeColor=#CFC7B9;strokeWidth=1.3;shadow=1;" vertex="1" parent="1"><mxGeometry x="238" y="530" width="452" height="134" as="geometry" /></mxCell><mxCell id="s67" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#0F5E63&quot;&gt;6 retrievers x depth 0 to 20&lt;/font&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=12;"